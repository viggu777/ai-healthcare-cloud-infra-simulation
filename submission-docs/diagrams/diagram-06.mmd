    Take --> Attempt
    Attempt --> FailMode
    FailMode --> SlowP
    FailMode --> ErrP
    FailMode --> CrashP
    FailMode --> EHRw
    SlowP --> EHRw
    EHRw --> OkP
    EHRw --> ReQ
    ReQ --> Loop
    EHRw --> DeadP
