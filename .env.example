# Copy to .env OR use --env-file environments/dev.env
# Never commit real secrets. This example uses placeholder values only.
COMPOSE_PROJECT_NAME=ai-healthcare-sim
APP_VERSION=0.1.0
GATEWAY_PORT=8080
GATEWAY_TLS_PORT=8443
LOG_LEVEL=info
MONGO_USER=app
MONGO_PASSWORD=change_me_in_env_file
MONGO_DB=healthcare
AI_API_KEY=change_me_in_env_file
EHR_URL=http://ehr-mock:8002
EHR_TIMEOUT_S=3
EHR_MODE=ok
WORKER_CONCURRENCY=2
WORKER_FAIL_MODE=off
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_in_env_file
