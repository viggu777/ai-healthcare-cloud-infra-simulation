# Local simulation secrets (real values, never commit).
# environments/dev.env + prod.env hold the LIVE local-simulation secrets and are
# NOT tracked (generate with scripts/setup-env.sh). Only .env.example (placeholders) is committed.
environments/dev.env
environments/prod.env
.env
*.local

# Node
node_modules/
npm-debug.log

# Python helpers
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Runtime artifacts (recreated by scripts, not source)
backups/backup-*/
backups/state-*/
!backups/.gitkeep
# Infra-plan snapshots are evidence like pipeline logs — committed intentionally
# (small text: resolved compose config + terraform lint + hashes).
# docs/infra-plan/ stays tracked.

# Local-only gateway TLS keypair (P1.1, generated by scripts/gen-gateway-cert.sh)
gateway/tls/
# Local alert-notification sink deliveries (P1.4 runtime artifact; .gitkeep stays)
monitoring/alert-notifications/*.log
# Scheduled-backup cron output (P1.5 runtime artifact)
backups/backup-cron.log

# Editor / OS
.vscode/
.idea/
.DS_Store
